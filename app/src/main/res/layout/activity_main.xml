<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- SearchView -->
        <SearchView
            android:id="@+id/searchView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"

            android:background="@drawable/searchview_background"
            android:iconifiedByDefault="false"
            android:queryHint="Bitki ara..." />

        <!-- Search Results RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchResultsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="8dp"
            android:visibility="gone" />

        <!-- Main Content ScrollView -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fitsSystemWindows="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Kartlar Başlıyor -->
                <!-- KART 1 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCategory1"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/imageCategory1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Kategori 1"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ataturkcicegi" />

                        <TextView
                            android:id="@+id/textCategory1"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_gravity="bottom"
                            android:gravity="center"
                            android:text="Saksı Bitkileri"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- KART 2 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCategory2"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:backgroundTint="@color/white"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/imageCategory2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Kategori 2"
                            android:scaleType="centerCrop"
                            android:src="@drawable/a" />

                        <TextView
                            android:id="@+id/textCategory2"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_gravity="bottom"
                            android:fontFamily="@font/alata"
                            android:gravity="center"
                            android:text="Ağaçlar"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- KART 3 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCategory3"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/imageCategory3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Kategori 3"
                            android:scaleType="centerCrop"
                            android:src="@drawable/begonya" />

                        <TextView
                            android:id="@+id/textCategory3"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_gravity="bottom"
                            android:fontFamily="@font/alata"
                            android:gravity="center"
                            android:text="Meyveler"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- KART 4 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCategory4"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/imageCategory4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Kategori 4"
                            android:scaleType="centerCrop"
                            android:src="@drawable/grow" />

                        <TextView
                            android:id="@+id/textCategory4"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_gravity="bottom"
                            android:fontFamily="@font/alata"
                            android:gravity="center"
                            android:text="Sebzeler"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- KART 5 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCategory5"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/imageCategory5"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Kategori 5"
                            android:scaleType="centerCrop"
                            android:src="@drawable/antoryum" />

                        <TextView
                            android:id="@+id/wrap"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_gravity="bottom"
                            android:fontFamily="@font/alata"
                            android:gravity="center"
                            android:text="Gübreleme"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- KART 6 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCategory6"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/imageCategory6"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Kategori 6"
                            android:scaleType="centerCrop"
                            android:src="@drawable/menekse" />

                        <TextView
                            android:id="@+id/textCategory6"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_gravity="bottom"
                            android:fontFamily="@font/alata"
                            android:gravity="center"
                            android:text="Budama"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
